        <record id="cultivo_cafe" model="fincas_pma.cultivo">
            <field name="name">Café</field>
            <field name="codigo">CAF</field>
            <field name="nombre_cientifico">Coffea spp.</field>
            <field name="familia_botanica">Rubiaceae</field>
            <field name="tipo_cultivo">perenne</field>
            <field name="vida_util_anios">25</field>
            <field name="meses_primera_cosecha">36</field>
            <field name="cosechas_por_anio">1</field>
            <field name="temp_min">15</field>
            <field name="temp_optima_min">18</field>
            <field name="temp_optima_max">24</field>
            <field name="temp_max">30</field>
            <field name="precipitacion_min">1200</field>
            <field name="precipitacion_optima">1800</field>
            <field name="precipitacion_max">2500</field>
            <field name="altitud_min">400</field>
            <field name="altitud_optima_min">1000</field>
            <field name="altitud_optima_max">1600</field>
            <field name="altitud_max">2000</field>
            <field name="ph_min">4.5</field>
            <field name="ph_optimo_min">5.5</field>
            <field name="ph_optimo_max">6.5</field>
            <field name="ph_max">7.0</field>
            <field name="rendimiento_promedio">20</field>
            <field name="description">Cultivo perenne de importancia económica en zonas de altura. Principal producto de exportación de varios países centroamericanos y Colombia.</field>
        </record>

