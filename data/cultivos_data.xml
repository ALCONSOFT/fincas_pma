        <record id="cultivo_pina" model="fincas_pma.cultivo">
            <field name="name">Piña</field>
            <field name="codigo">PIN</field>
            <field name="nombre_cientifico">Ananas comosus</field>
            <field name="familia_botanica">Bromeliaceae</field>
            <field name="tipo_cultivo">semipermanente</field>
