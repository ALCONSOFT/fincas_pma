            <field name="familia_botanica">Musaceae</field>
            <field name="tipo_cultivo">semipermanente</field>
            <field name="ciclo_dias">365</field>
            <field name="vida_util_anios">15</field>
            <field name="meses_primera_cosecha">12</field>
            <field name="cosechas_por_anio">52</field>
            <field name="temp_min">15</field>
            <field name="temp_optima_min">25</field>
            <field name="temp_optima_max">30</field>
            <field name="temp_max">35</field>
            <field name="precipitacion_min">1500</field>
            <field name="precipitacion_optima">2500</field>
            <field name="precipitacion_max">4000</field>
            <field name="altitud_min">0</field>
