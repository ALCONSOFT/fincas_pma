            <field name="altitud_optima_max">300</field>
            <field name="altitud_max">1000</field>
            <field name="ph_min">5.5</field>
            <field name="ph_optimo_min">6.0</field>
            <field name="ph_optimo_max">7.0</field>
            <field name="ph_max">7.5</field>
            <field name="rendimiento_promedio">2500</field>
            <field name="description">Cultivo tropical de exportación. Panamá, Costa Rica y Ecuador son los principales exportadores de la región.</field>
