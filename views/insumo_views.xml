<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================== -->
    <!-- TIPO DE INSUMO - VISTAS                            -->
    <!-- ================================================== -->

    <record id="view_tipo_insumo_list" model="ir.ui.view">
        <field name="name">fincas_pma.tipo_insumo.list</field>
        <field name="model">fincas_pma.tipo_insumo</field>
        <field name="arch" type="xml">
            <list string="Tipos de Insumo" editable="bottom">
                <field name="secuencia" widget="handle"/>
                <field name="codigo"/>
                <field name="name"/>
                <field name="es_fertilizante"/>
                <field name="es_agroquimico"/>
                <field name="es_biologico"/>
                <field name="requiere_carencia"/>
            </list>
        </field>
    </record>

    <record id="action_tipo_insumo" model="ir.actions.act_window">
        <field name="name">Tipos de Insumo</field>
        <field name="res_model">fincas_pma.tipo_insumo</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ================================================== -->
    <!-- INSUMO - VISTAS                                    -->
    <!-- ================================================== -->

    <!-- Insumo - Vista Lista -->
    <record id="view_insumo_list" model="ir.ui.view">
        <field name="name">fincas_pma.insumo.list</field>
        <field name="model">fincas_pma.insumo</field>
        <field name="arch" type="xml">
            <list string="Insumos Agrícolas"
                  decoration-danger="lista_roja == True"
                  decoration-success="permitido_organico == True">
                <field name="codigo"/>
                <field name="name"/>
                <field name="tipo_insumo_id"/>
                <field name="categoria"/>
                <field name="ingrediente_activo"/>
                <field name="formula_npk" optional="show"/>
                <field name="categoria_toxicologica" widget="badge"
                       decoration-danger="categoria_toxicologica in ('Ia', 'Ib')"
                       decoration-warning="categoria_toxicologica == 'II'"
                       decoration-info="categoria_toxicologica == 'III'"
                       decoration-success="categoria_toxicologica == 'IV'"/>
                <field name="periodo_carencia_dias"/>
                <field name="permitido_organico"/>
                <field name="permitido_rainforest"/>
                <field name="lista_roja" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Insumo - Vista Formulario -->
    <record id="view_insumo_form" model="ir.ui.view">
        <field name="name">fincas_pma.insumo.form</field>
        <field name="model">fincas_pma.insumo</field>
        <field name="arch" type="xml">
            <form string="Insumo Agrícola">
                <sheet>
                    <widget name="web_ribbon" title="LISTA ROJA" bg_color="bg-danger"
                            invisible="not lista_roja"/>
                    <widget name="web_ribbon" title="ORGÁNICO" bg_color="bg-success"
                            invisible="not permitido_organico"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre comercial"/></h1>
                        <field name="ingrediente_activo" placeholder="Ingrediente activo"/>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="codigo"/>
                            <field name="tipo_insumo_id"/>
                            <field name="categoria"/>
                            <field name="formulacion"/>
                            <field name="concentracion"/>
                            <field name="active"/>
                        </group>
                        <group string="Fabricante">
                            <field name="fabricante"/>
                            <field name="distribuidor"/>
                            <field name="numero_registro"/>
                            <field name="pais_registro"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Composición NPK" name="npk"
                              invisible="categoria not in ('fertilizante_quimico', 'fertilizante_organico', 'foliar')">
                            <group>
                                <group>
                                    <field name="nitrogeno_pct"/>
                                    <field name="fosforo_pct"/>
                                    <field name="potasio_pct"/>
                                    <field name="formula_npk"/>
                                </group>
                                <group>
                                    <field name="calcio_pct"/>
                                    <field name="magnesio_pct"/>
                                    <field name="azufre_pct"/>
                                </group>
                            </group>
                            <group>
                                <field name="otros_elementos" placeholder="Microelementos: Fe, Mn, Zn, B..."/>
                            </group>
                        </page>
                        <page string="Toxicidad y Seguridad" name="seguridad">
                            <group>
                                <group string="Clasificación Toxicológica">
                                    <field name="categoria_toxicologica"/>
                                    <field name="color_etiqueta"/>
                                    <field name="pictogramas_seguridad"/>
                                </group>
                                <group string="Períodos de Seguridad">
                                    <field name="periodo_carencia_dias"/>
                                    <field name="periodo_reentrada_horas"/>
                                    <field name="intervalo_aplicacion_dias"/>
                                    <field name="max_aplicaciones_ciclo"/>
                                </group>
                            </group>
                            <group>
                                <field name="epp_requerido" placeholder="Guantes, gafas, mascarilla..."/>
                            </group>
                            <group>
                                <group>
                                    <field name="primeros_auxilios"/>
                                </group>
                                <group>
                                    <field name="antidoto"/>
                                </group>
                            </group>
                        </page>
                        <page string="Restricciones Ambientales" name="ambiente">
                            <group>
                                <group>
                                    <field name="restriccion_lluvia_horas"/>
                                    <field name="no_aplicar_floracion"/>
                                </group>
                                <group>
                                    <field name="temp_min_aplicacion"/>
                                    <field name="temp_max_aplicacion"/>
                                    <field name="humedad_min"/>
                                    <field name="humedad_max"/>
                                    <field name="velocidad_viento_max"/>
                                </group>
                            </group>
                        </page>
                        <page string="Certificaciones" name="certificaciones">
                            <group>
                                <group string="Permitido en:">
                                    <field name="permitido_organico"/>
                                    <field name="lista_omri"/>
                                    <field name="permitido_rainforest"/>
                                    <field name="permitido_globalgap"/>
                                </group>
                                <group string="Restricciones">
                                    <field name="lista_roja"/>
                                </group>
                            </group>
                            <group>
                                <field name="restricciones_certificacion" placeholder="Restricciones específicas por certificación..."/>
                            </group>
                        </page>
                        <page string="Dosificación" name="dosis">
                            <group>
                                <group>
                                    <field name="dosis_minima"/>
                                    <field name="dosis_recomendada"/>
                                    <field name="dosis_maxima"/>
                                    <field name="unidad_dosis_id"/>
                                </group>
                                <group>
                                    <field name="volumen_agua_recomendado"/>
                                </group>
                            </group>
                            <group>
                                <field name="cultivo_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="plagas_objetivo" placeholder="Plagas o enfermedades objetivo..."/>
                                <field name="modo_accion" placeholder="Modo de acción del producto..."/>
                            </group>
                        </page>
                        <page string="Almacenamiento" name="almacenamiento">
                            <group>
                                <group>
                                    <field name="vida_util_meses"/>
                                </group>
                            </group>
                            <group>
                                <field name="condiciones_almacenamiento" placeholder="Condiciones de almacenamiento..."/>
                            </group>
                        </page>
                        <page string="Documentos" name="documentos">
                            <group>
                                <group>
                                    <field name="ficha_tecnica" filename="ficha_tecnica_nombre"/>
                                    <field name="ficha_tecnica_nombre" invisible="1"/>
                                </group>
                                <group>
                                    <field name="hoja_seguridad" filename="hoja_seguridad_nombre"/>
                                    <field name="hoja_seguridad_nombre" invisible="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="descripcion"/>
                                <field name="notas"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Insumo - Búsqueda -->
    <record id="view_insumo_search" model="ir.ui.view">
        <field name="name">fincas_pma.insumo.search</field>
        <field name="model">fincas_pma.insumo</field>
        <field name="arch" type="xml">
            <search string="Buscar Insumos">
                <field name="name"/>
                <field name="codigo"/>
                <field name="ingrediente_activo"/>
                <field name="tipo_insumo_id"/>
                <filter string="Fertilizantes" name="fertilizantes"
                        domain="[('categoria', 'in', ['fertilizante_quimico', 'fertilizante_organico', 'foliar'])]"/>
                <filter string="Agroquímicos" name="agroquimicos"
                        domain="[('categoria', 'in', ['herbicida', 'fungicida', 'insecticida'])]"/>
                <filter string="Biológicos" name="biologicos" domain="[('categoria', '=', 'biocontrol')]"/>
                <separator/>
                <filter string="Permitido Orgánico" name="organico" domain="[('permitido_organico', '=', True)]"/>
                <filter string="Permitido RA" name="rainforest" domain="[('permitido_rainforest', '=', True)]"/>
                <filter string="Lista Roja" name="lista_roja" domain="[('lista_roja', '=', True)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_insumo_id'}"/>
                    <filter string="Categoría" name="group_categoria" context="{'group_by': 'categoria'}"/>
                    <filter string="Toxicidad" name="group_toxicidad" context="{'group_by': 'categoria_toxicologica'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Insumo - Acción -->
    <record id="action_insumo" model="ir.actions.act_window">
        <field name="name">Insumos Agrícolas</field>
        <field name="res_model">fincas_pma.insumo</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_tipo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo insumo
            </p>
            <p>
                Registre fertilizantes, agroquímicos y productos biológicos
                con información de toxicidad y restricciones de certificación.
            </p>
        </field>
    </record>

    <!-- ================================================== -->
    <!-- APLICACIÓN - VISTAS                                -->
    <!-- ================================================== -->

    <!-- Aplicación - Vista Lista -->
    <record id="view_aplicacion_list" model="ir.ui.view">
        <field name="name">fincas_pma.aplicacion.list</field>
        <field name="model">fincas_pma.aplicacion</field>
        <field name="arch" type="xml">
            <list string="Aplicaciones de Insumos"
                  decoration-danger="en_periodo_carencia == True"
                  decoration-warning="alerta_certificacion == True">
                <field name="fecha_aplicacion"/>
                <field name="lote_id"/>
                <field name="insumo_id"/>
                <field name="categoria_insumo"/>
                <field name="area_aplicada_ha" sum="Total Ha"/>
                <field name="dosis_aplicada"/>
                <field name="unidad_dosis_id"/>
                <field name="metodo_aplicacion"/>
                <field name="objetivo"/>
                <field name="fecha_carencia"/>
                <field name="estado" widget="badge"
                       decoration-info="estado == 'planificada'"
                       decoration-warning="estado == 'en_progreso'"
                       decoration-success="estado == 'completada'"/>
                <field name="en_periodo_carencia" column_invisible="True"/>
                <field name="alerta_certificacion" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Aplicación - Vista Formulario -->
    <record id="view_aplicacion_form" model="ir.ui.view">
        <field name="name">fincas_pma.aplicacion.form</field>
        <field name="model">fincas_pma.aplicacion</field>
        <field name="arch" type="xml">
            <form string="Aplicación de Insumo">
                <header>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="planificada,en_progreso,completada"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="EN CARENCIA" bg_color="bg-danger"
                            invisible="not en_periodo_carencia"/>
                    <widget name="web_ribbon" title="ALERTA CERT." bg_color="bg-warning"
                            invisible="not alerta_certificacion"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Ubicación">
                            <field name="lote_id"/>
                            <field name="finca_id"/>
                            <field name="cultivo_id"/>
                            <field name="area_aplicada_ha"/>
                        </group>
                        <group string="Insumo">
                            <field name="insumo_id"/>
                            <field name="tipo_insumo_id"/>
                            <field name="objetivo"/>
                            <field name="plaga_enfermedad"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dosificación">
                            <field name="dosis_aplicada"/>
                            <field name="unidad_dosis_id"/>
                            <field name="cantidad_total"/>
                            <field name="volumen_agua"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_aplicacion"/>
                            <field name="fecha_carencia"/>
                            <field name="en_periodo_carencia"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Método de Aplicación" name="metodo">
                            <group>
                                <group>
                                    <field name="metodo_aplicacion"/>
                                    <field name="equipo_utilizado"/>
                                    <field name="boquilla_tipo"/>
                                </group>
                                <group string="Trazabilidad del Insumo">
                                    <field name="lote_insumo"/>
                                    <field name="fecha_fabricacion_insumo"/>
                                    <field name="fecha_vencimiento_insumo"/>
                                </group>
                            </group>
                        </page>
                        <page string="Condiciones Climáticas" name="clima">
                            <group>
                                <group>
                                    <field name="condicion_climatica"/>
                                    <field name="temperatura"/>
                                </group>
                                <group>
                                    <field name="humedad_relativa"/>
                                    <field name="velocidad_viento"/>
                                </group>
                            </group>
                        </page>
                        <page string="Personal" name="personal">
                            <group>
                                <group>
                                    <field name="aplicador_ids" widget="many2many_tags"/>
                                    <field name="supervisor_id"/>
                                </group>
                                <group>
                                    <field name="horas_trabajo"/>
                                    <field name="jornales"/>
                                </group>
                            </group>
                        </page>
                        <page string="Efectividad" name="efectividad">
                            <group>
                                <group>
                                    <field name="fecha_evaluacion"/>
                                    <field name="efectividad"/>
                                </group>
                            </group>
                            <group>
                                <field name="observaciones_efectividad"/>
                            </group>
                        </page>
                        <page string="Costos" name="costos">
                            <group>
                                <group>
                                    <field name="costo_insumo"/>
                                    <field name="costo_mano_obra"/>
                                    <field name="costo_total"/>
                                </group>
                            </group>
                        </page>
                        <page string="Observaciones" name="observaciones">
                            <field name="observaciones" placeholder="Observaciones generales..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Aplicación - Vista Calendario -->
    <record id="view_aplicacion_calendar" model="ir.ui.view">
        <field name="name">fincas_pma.aplicacion.calendar</field>
        <field name="model">fincas_pma.aplicacion</field>
        <field name="arch" type="xml">
            <calendar string="Aplicaciones" date_start="fecha_aplicacion" color="tipo_insumo_id" mode="month">
                <field name="lote_id"/>
                <field name="insumo_id"/>
                <field name="area_aplicada_ha"/>
            </calendar>
        </field>
    </record>

    <!-- Aplicación - Búsqueda -->
    <record id="view_aplicacion_search" model="ir.ui.view">
        <field name="name">fincas_pma.aplicacion.search</field>
        <field name="model">fincas_pma.aplicacion</field>
        <field name="arch" type="xml">
            <search string="Buscar Aplicaciones">
                <field name="lote_id"/>
                <field name="insumo_id"/>
                <field name="finca_id"/>
                <filter string="Hoy" name="today" domain="[('fecha_aplicacion', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('fecha_aplicacion', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <filter string="Esta Semana" name="this_week" domain="[('fecha_aplicacion', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="En Carencia" name="carencia" domain="[('en_periodo_carencia', '=', True)]"/>
                <filter string="Alerta Certificación" name="alerta" domain="[('alerta_certificacion', '=', True)]"/>
                <separator/>
                <filter string="Fertilizaciones" name="fertilizacion" domain="[('objetivo', '=', 'nutricion')]"/>
                <filter string="Control Plagas" name="plagas" domain="[('objetivo', 'in', ['preventivo', 'curativo'])]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Lote" name="group_lote" context="{'group_by': 'lote_id'}"/>
                    <filter string="Insumo" name="group_insumo" context="{'group_by': 'insumo_id'}"/>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_insumo_id'}"/>
                    <filter string="Fecha" name="group_fecha" context="{'group_by': 'fecha_aplicacion:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Aplicación - Acción -->
    <record id="action_aplicacion" model="ir.actions.act_window">
        <field name="name">Aplicaciones</field>
        <field name="res_model">fincas_pma.aplicacion</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar una nueva aplicación
            </p>
            <p>
                Registre todas las aplicaciones de insumos con trazabilidad completa.
            </p>
        </field>
    </record>

</odoo>
